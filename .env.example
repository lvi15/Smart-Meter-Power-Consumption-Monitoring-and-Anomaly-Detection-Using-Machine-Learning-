# ==============================================================================
# Smart Meter Streaming Analytics - Configuration Template
# Copy this file to '.env' and update with your local environment settings.
# ==============================================================================

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=smartmeter-events
KAFKA_CONSUMER_GROUP=smartmeter-processor-group
KAFKA_AUTO_OFFSET_RESET=latest

# MySQL Database Configuration
# Default root or user credentials for local MySQL installation or Docker container
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_meter_db
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

# Database dialect (mysql or sqlite for local dev fallback)
DB_TYPE=mysql
SQLITE_DB_PATH=data/smart_meter_dev.db

# Producer Configuration
PRODUCER_DELAY_SECONDS=1.0
DATASET_PATH=data/smart_meter_readings.csv

# Machine Learning Model Configuration
MODEL_PATH=models/anomaly_model.pkl
MODEL_CONTAMINATION=0.01
EVALUATION_REPORT_PATH=reports/model_evaluation.json

# Stream Processing Configuration
ROLLING_WINDOW_SIZE=30

# Dashboard Configuration
DASHBOARD_REFRESH_INTERVAL=3

